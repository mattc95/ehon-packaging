---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { breadcrumbJsonLd } from "../../../data/seo";

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.section === "guide")).sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Base title="Cosmetic Packaging Guide" description="Evergreen guides from EHON on jars, lip gloss tubes and how to approve cosmetic packaging components." path="/resources/packaging-guide" jsonLd={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Packaging Guide", path: "/resources/packaging-guide" }])]}>
  <main class="section">
    <div class="wrap">
      <nav class="crumb"><a href="/">Home</a><span>/</span><span>Packaging Guide</span></nav>
      <div class="eyebrow">Packaging guide</div>
      <h1>Practical guides for specifying a pack.</h1>
      <div class="article-list" style="margin-top:28px">
        {posts.map((post) => (
          <a class="article-mini" href={`/resources/packaging-guide/${post.id}`}>
            <img src={post.data.image} alt={post.data.imageAlt} />
            <div><span class="tag">Guide</span><strong>{post.data.title}</strong></div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
