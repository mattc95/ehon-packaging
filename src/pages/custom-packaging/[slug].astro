---
import ContentPage from "../../components/ContentPage.astro";
import { customPages } from "../../../lib/company";

export function getStaticPaths() {
  return customPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
---
<ContentPage page={page} crumbs={[{ name: "Home", path: "/" }, { name: "Custom Packaging", path: "/custom-packaging/oem-odm" }, { name: page.navLabel, path: page.path }]} />
