---
import { products } from "../../lib/products";
import { site } from "../../lib/site";
import { localizePath, type Locale } from "../../lib/i18n";
import { getPageCopy, getUi } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const ui = getUi(locale);
const href = (path: string) => localizePath(path, locale);
const label = (slug: string, fallback: string) => getPageCopy(locale, slug)?.navLabel || fallback;
---
<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/assets/logo.png" alt="EHON Packaging" />
        <p>{site.legalName} — {ui.footer.blurb}</p>
      </div>
      <div class="foot-col">
        <strong>{ui.footer.products}</strong>
        {products.slice(0, 6).map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
      </div>
      <div class="foot-col">
        <strong>{ui.footer.company}</strong>
        <a href={href("/capabilities/sampling-prototyping")}>{label("sampling-prototyping", "Sampling & Prototyping")}</a>
        <a href={href("/capabilities/manufacturing")}>{label("manufacturing", "Manufacturing & Decoration")}</a>
        <a href={href("/capabilities/quality-control")}>{label("quality-control", "Quality Control")}</a>
        <a href={href("/about/our-story")}>{label("our-story", "Company Overview")}</a>
        <a href={href("/about/factory")}>{label("factory", "Factory Tour")}</a>
        <a href={href("/about/certificates")}>{label("certificates", "Certifications")}</a>
        <a href={href("/resources/faq")}>{ui.footer.faq}</a>
      </div>
      <div class="foot-col">
        <strong>{ui.footer.contact}</strong>
        <span>{site.address.full}</span>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={href("/contact/request-a-quote")}>{ui.footer.quote}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {ui.footer.rights} {site.legalName}.</span>
      <span><a href={href("/privacy")}>{ui.footer.privacy}</a> · <a href={href("/terms")}>{ui.footer.terms}</a> · <a href={href("/sitemap")}>{ui.footer.sitemap}</a></span>
    </div>
  </div>
</footer>
