---
import { products } from "../../lib/products";
import { capabilityPages, aboutPages, capabilityNavSlugs, aboutNavSlugs } from "../../lib/company";
import { localizePath, locales, localeIds, type Locale } from "../../lib/i18n";
import { getUi, getPageCopy } from "../i18n";

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = "en", path = "/" } = Astro.props;
const ui = getUi(locale);
const href = (value: string) => localizePath(value, locale);
const label = (slug: string, fallback: string) => getPageCopy(locale, slug)?.navLabel || fallback;
const current = locales[locale];
const capabilityNav = capabilityNavSlugs.map((slug) => capabilityPages.find((item) => item.slug === slug)).filter((item) => item !== undefined);
const aboutNav = aboutNavSlugs.map((slug) => aboutPages.find((item) => item.slug === slug)).filter((item) => item !== undefined);
---
<nav class="nav">
  <div class="wrap nav-inner">
    <div class="nav-start">
      <button class="menu" id="menu-btn" aria-label={ui.nav.openMenu} aria-expanded="false">☰</button>
      <a class="brand" href={href("/")} aria-label="EHON Packaging"><img src="/assets/logo.png" alt="EHON Packaging" /></a>
    </div>
    <div class="nav-links">
      <div class="nav-item">
        <a href={href("/products")}>{ui.nav.products}</a>
        <div class="dropdown wide">
          <div class="dropdown-panel">
            {products.map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href={href("/capabilities/sampling-prototyping")}>{ui.nav.capabilities}</a>
        <div class="dropdown">
          <div class="dropdown-panel">
            {capabilityNav.map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href={href("/about/our-story")}>{ui.nav.about}</a>
        <div class="dropdown">
          <div class="dropdown-panel">
            {aboutNav.map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
          </div>
        </div>
      </div>
      <div class="nav-item">
        <a href={href("/resources/packaging-guide")}>{ui.nav.resources}</a>
        <div class="dropdown">
          <div class="dropdown-panel">
            <a href={href("/resources/packaging-guide")}>{ui.nav.guide}</a>
            <a href={href("/resources/faq")}>{ui.nav.faq}</a>
          </div>
        </div>
      </div>
      <a href={href("/news/exhibitions")}>{ui.nav.news}</a>
    </div>
    <div class="nav-actions">
      <div class="nav-item lang-switch">
        <button type="button" class="lang-trigger" aria-haspopup="true" aria-expanded="false" aria-label={ui.nav.language}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path d="M12 3c2.4 2.7 3.7 5.7 3.7 9s-1.3 6.3-3.7 9c-2.4-2.7-3.7-5.7-3.7-9s1.3-6.3 3.7-9z"></path>
          </svg>
          <span>{current.short}</span>
        </button>
        <div class="dropdown lang-menu">
          <div class="dropdown-panel">
            {localeIds.map((id) => (
              <a href={localizePath(path, id)} hrefLang={locales[id].htmlLang} lang={locales[id].htmlLang} aria-current={id === locale ? "true" : undefined}>{locales[id].switcher}</a>
            ))}
          </div>
        </div>
      </div>
      <a class="btn primary" href={href("/contact/request-a-quote")}>{ui.nav.quote} <span>↗</span></a>
    </div>
  </div>
  <div class="mobile-panel" id="mobile-panel">
    <div class="wrap">
      <div class="mobile-acc">
        <button type="button" class="mobile-acc-btn" aria-expanded="false">
          {ui.nav.products}
          <span class="chevron" aria-hidden="true"></span>
        </button>
        <div class="mobile-acc-panel">
          {products.map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
        </div>
      </div>
      <div class="mobile-acc">
        <button type="button" class="mobile-acc-btn" aria-expanded="false">
          {ui.nav.capabilities}
          <span class="chevron" aria-hidden="true"></span>
        </button>
        <div class="mobile-acc-panel">
          {capabilityNav.map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
        </div>
      </div>
      <div class="mobile-acc">
        <button type="button" class="mobile-acc-btn" aria-expanded="false">
          {ui.nav.about}
          <span class="chevron" aria-hidden="true"></span>
        </button>
        <div class="mobile-acc-panel">
          {aboutNav.map((item) => <a href={href(item.path)}>{label(item.slug, item.navLabel)}</a>)}
        </div>
      </div>
      <div class="mobile-acc">
        <button type="button" class="mobile-acc-btn" aria-expanded="false">
          {ui.nav.resources}
          <span class="chevron" aria-hidden="true"></span>
        </button>
        <div class="mobile-acc-panel">
          <a href={href("/resources/packaging-guide")}>{ui.nav.guide}</a>
          <a href={href("/resources/faq")}>{ui.nav.faq}</a>
        </div>
      </div>
      <a class="mobile-link" href={href("/news/exhibitions")}>{ui.nav.news}</a>
    </div>
  </div>
</nav>
<script>
  const btn = document.querySelector<HTMLButtonElement>("#menu-btn");
  const panel = document.querySelector<HTMLElement>("#mobile-panel");
  const lang = document.querySelector<HTMLElement>(".lang-switch");
  const langBtn = lang?.querySelector<HTMLButtonElement>(".lang-trigger");

  function setLangOpen(open: boolean) {
    lang?.classList.toggle("open", open);
    langBtn?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  function setAccordion(item: Element, open: boolean) {
    item.classList.toggle("open", open);
    item.querySelector(".mobile-acc-btn")?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  panel?.querySelectorAll(".mobile-acc").forEach((item) => {
    setAccordion(item, false);
    item.querySelector(".mobile-acc-btn")?.addEventListener("click", () => {
      setAccordion(item, !item.classList.contains("open"));
    });
  });

  btn?.addEventListener("click", () => {
    const open = panel?.classList.toggle("open") ?? false;
    btn.setAttribute("aria-expanded", open ? "true" : "false");
    setLangOpen(false);
    if (!open) panel?.querySelectorAll(".mobile-acc").forEach((item) => setAccordion(item, false));
  });

  langBtn?.addEventListener("click", (event) => {
    event.stopPropagation();
    setLangOpen(!lang?.classList.contains("open"));
  });

  document.addEventListener("click", (event) => {
    if (lang && !lang.contains(event.target as Node)) setLangOpen(false);
  });
</script>
