---
import Base from "../layouts/Base.astro";
import QuoteForm from "./QuoteForm.astro";
import { products } from "../../lib/products";
import { site } from "../../lib/site";
import { faqJsonLd, breadcrumbJsonLd } from "../data/seo";
import { localizePath, type Locale } from "../../lib/i18n";
import { getFaqs, getPageCopy, getUi } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const ui = getUi(locale);
const h = ui.home;
const href = (path: string) => localizePath(path, locale);
const homeFaqs = getFaqs(locale).slice(0, 6);
---
<Base title={h.title} description={h.description} path="/" locale={locale} jsonLd={[faqJsonLd(homeFaqs), breadcrumbJsonLd([{ name: ui.chrome.home, path: href("/") }])]}>
  <main>
    <section class="home-video" aria-label={h.videoLabel}>
      <video class="home-video-player" autoplay muted loop playsinline preload="auto" poster="/hero-poster.jpg">
        <source src="/hero_v2.webm" type="video/webm" />
      </video>
      <div class="home-video-overlay" aria-hidden="true"></div>
    </section>
    <section class="discover reveal">
      <div class="wrap">
        <div class="eyebrow">{h.eyebrow}</div>
        <h1>{h.h1}</h1>
        <p class="lead">{h.sub}</p>
        <div class="stat-row">
          <div class="stat"><b>{h.years}</b><span>{h.yearsLabel}</span></div>
          <div class="stat"><b>40,000㎡</b><span>{h.factory}</span></div>
          <div class="stat"><b>1,000+</b><span>{h.designs}</span></div>
        </div>
      </div>
    </section>
    <section class="section reveal">
      <div class="wrap">
        <h2>{h.custom}</h2>
        <p class="hero-line">{h.customH}</p>
        <p class="lead">{h.customLead}</p>
        <div class="hero-actions">
          <a class="btn primary" href={href("/products")}>{h.explore} <span aria-hidden="true">↗</span></a>
          <a class="btn" href="#rfq">{h.start}</a>
        </div>
        <div class="process">
          {h.steps.map((item, index) => (
            <div class="step">
              <div class="num">{String(index + 1).padStart(2, "0")}</div>
              <strong>{item.title}</strong>
              <p>{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="section white reveal">
      <div class="wrap">
        <p class="stock-kicker">{h.categoriesH}</p>
        <div class="stock-acc">
          <h2>{h.portfolioH}</h2>
          <a class="btn" href={href("/products")}>{h.viewProducts}</a>
        </div>
        <div class="rail-stage">
          <button type="button" class="rail-btn prev" id="cat-prev" aria-label={h.scrollPrev}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" class="rail-btn next" id="cat-next" aria-label={h.scrollNext}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <div class="cat-rail" id="cat-rail">
            {products.map((item) => (
              <a class="cat" href={href(item.path)}>
                <div class="cat-media"><img src={item.image} alt={getPageCopy(locale, item.slug)?.imageAlt || item.imageAlt} /></div>
                <div class="cat-copy">
                  <strong>{getPageCopy(locale, item.slug)?.navLabel || item.navLabel}</strong>
                  <span class="more-plus">{h.morePlus}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section class="section compact reveal">
      <div class="wrap">
        <div class="eyebrow">{h.faqEyebrow}</div>
        <h2>{h.faqH}</h2>
        <div class="faq">
          {homeFaqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
        <p style="margin-top:18px"><a class="btn ghost" href={href("/resources/faq")}>{h.allFaq} <span>↗</span></a></p>
      </div>
    </section>
    <section class="section reveal" id="rfq">
      <div class="wrap">
        <div class="cta">
          <div>
            <div class="eyebrow" style="color:#938c84">{h.ctaEyebrow}</div>
            <h2>{h.ctaH}</h2>
            <p>{h.ctaP}</p>
            <div class="hero-trust" style="border-color:#2d2d2d;margin-top:35px">
              <div class="trust-item"><b>WhatsApp</b><span>{site.whatsappDisplay}</span></div>
              <div class="trust-item"><b>Email</b><span>{site.email}</span></div>
            </div>
          </div>
          <QuoteForm locale={locale} />
        </div>
      </div>
    </section>
  </main>
  <script>
    const hero = document.querySelector(".home-video-player");
    if (hero instanceof HTMLVideoElement && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      hero.removeAttribute("autoplay");
      hero.pause();
    }
    const rail = document.querySelector("#cat-rail");
    const cardStep = () => {
      if (!(rail instanceof HTMLElement)) return 272;
      const card = rail.querySelector(".cat");
      if (!(card instanceof HTMLElement)) return 272;
      const gap = Number.parseFloat(getComputedStyle(rail).columnGap || getComputedStyle(rail).gap) || 0;
      return card.getBoundingClientRect().width + gap;
    };
    let frame = 0;
    const scrollCard = (direction: number) => {
      if (!(rail instanceof HTMLElement)) return;
      const start = rail.scrollLeft;
      const max = rail.scrollWidth - rail.clientWidth;
      const target = Math.max(0, Math.min(max, start + direction * cardStep()));
      cancelAnimationFrame(frame);
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        rail.scrollLeft = target;
        return;
      }
      const duration = 520;
      const began = performance.now();
      const tick = (now: number) => {
        const progress = Math.min(1, (now - began) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        rail.scrollLeft = start + (target - start) * eased;
        if (progress < 1) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };
    document.querySelector("#cat-prev")?.addEventListener("click", () => scrollCard(-1));
    document.querySelector("#cat-next")?.addEventListener("click", () => scrollCard(1));

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight) {
              entry.target.classList.remove("will-reveal");
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -40px 0px", threshold: 0.05 }
      );
      document.querySelectorAll(".reveal").forEach((el) => {
        const top = el.getBoundingClientRect().top;
        if (top > window.innerHeight) {
          el.classList.add("will-reveal");
          observer.observe(el);
        } else {
          el.classList.add("revealed");
        }
      });
    }
  </script>
</Base>
