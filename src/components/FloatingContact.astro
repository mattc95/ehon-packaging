---
import { site, whatsappHref, lineHref } from "../../lib/site";
import type { Locale } from "../../lib/i18n";
import { getUi } from "../i18n";

interface Props {
  locale?: Locale;
}
const { locale = "en" } = Astro.props;
const ui = getUi(locale);
---
<div class="dock" aria-label={ui.float.contact}>
  <a href={whatsappHref(ui.float.whatsappText)} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 3.5A10.5 10.5 0 0 0 2.1 17.2L1 23l5.9-1.5A10.5 10.5 0 1 0 20 3.5zM12 19.6a8.1 8.1 0 0 1-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.1 8.1 0 1 1 12 19.6zm4.6-6.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.6 6.6 0 0 1-2-1.2 7.3 7.3 0 0 1-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.5.2-.3c.1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.7 11.7 0 0 0 4.4 3.9c.6.2 1.1.4 1.5.5a3.5 3.5 0 0 0 1.6.1 2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c-.1-.2-.2-.2-.4-.3z"/></svg>
  </a>
  <button type="button" id="wechat-btn" aria-label="WeChat">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 4C5.4 4 2 6.7 2 10.1c0 1.9 1.1 3.6 2.8 4.8L4.2 17l2.4-1.2c.8.2 1.6.4 2.4.4.3 0 .6 0 .9-.1-.2-.6-.3-1.2-.3-1.8 0-3.5 3.3-6.3 7.4-6.3.3 0 .5 0 .8.1C16.8 5.6 13.4 4 9.5 4zm-2 3.2a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm4.2 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zM16.2 9.2c-3.4 0-6.2 2.3-6.2 5.2s2.8 5.2 6.2 5.2c.6 0 1.2-.1 1.8-.2l2 .9-.5-1.7c1.3-.9 2.1-2.2 2.1-3.7 0-2.9-2.8-5.2-6.2-5.2zm-2.1 2.6a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5zm4.2 0a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z"/></svg>
  </button>
  <a href={lineHref()} target="_blank" rel="noopener noreferrer" aria-label="Line">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.5 4.5H4.4C3.1 4.5 2 5.6 2 7v7.2c0 1.4 1.1 2.5 2.4 2.5h8.2l3.6 2.6c.3.2.7 0 .7-.4v-2.2h2.6c1.3 0 2.4-1.1 2.4-2.5V7c0-1.4-1.1-2.5-2.4-2.5zM8.2 12.2H6.7V8.4h1.5v3.8zm3.3 0H10V8.4h1.5v3.8zm1.6 0h-1.4l1.8-3.8h1.6l-2 3.8zm4.2-2.3h-1.2v.7h1.2v1.2h-1.2v.4h1.4v1.2h-2.8V8.4h2.8v1.5h-1.4z"/></svg>
  </a>
  <div class="dock-card" id="wechat-card" hidden>
    <b>WeChat</b>
    <p>{ui.float.wechatLead}</p>
    <strong id="wechat-id">{site.wechatId}</strong>
    <p style="margin-top:8px">Line ID: {site.lineId}</p>
    <button class="btn primary" type="button" id="copy-wechat" style="margin-top:8px">{ui.float.copy}</button>
  </div>
</div>
<script define:vars={{ wechatId: site.wechatId }}>
  const btn = document.querySelector("#wechat-btn");
  const card = document.querySelector("#wechat-card");
  btn?.addEventListener("click", () => {
    if (!card) return;
    card.hidden = !card.hidden;
  });
  document.querySelector("#copy-wechat")?.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(wechatId); } catch { /* ignore */ }
  });
</script>
