---
import type { SeoPage } from "../../lib/types";
import type { Locale } from "../../lib/i18n";
import { localizePath } from "../../lib/i18n";
import Base from "../layouts/Base.astro";
import QuoteForm from "./QuoteForm.astro";
import { breadcrumbJsonLd, faqJsonLd, serviceJsonLd } from "../data/seo";
import { getUi } from "../i18n";

interface Props {
  page: SeoPage;
  crumbs: { name: string; path: string }[];
  locale?: Locale;
}
const { page, crumbs, locale = "en" } = Astro.props;
const ui = getUi(locale);
const href = (path: string) => localizePath(path, locale);
const jsonLd = [
  breadcrumbJsonLd(crumbs),
  faqJsonLd(page.faqs),
  serviceJsonLd(page.navLabel, page.description, page.path),
];
---
<Base title={page.title} description={page.description} path={page.path} image={page.image} jsonLd={jsonLd} locale={locale}>
  <main>
    <section class="hero inner-hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <nav class="crumb" aria-label="Breadcrumb">
            {crumbs.map((crumb, i) => (
              <>
                {i > 0 && <span>/</span>}
                {i < crumbs.length - 1 ? <a href={crumb.path}>{crumb.name}</a> : <span>{crumb.name}</span>}
              </>
            ))}
          </nav>
          <div class="eyebrow">{page.eyebrow}</div>
          <h1>{page.h1}</h1>
          <p class="sub">{page.lead}</p>
          <div class="hero-actions">
            <a class="btn primary" href={href("/contact/request-a-quote")}>{ui.chrome.quote} <span>↗</span></a>
            <a class="btn ghost" href={href("/products")}>{ui.chrome.browse}</a>
          </div>
        </div>
        <div class="hero-visual">
          <img src={page.image} alt={page.imageAlt} />
        </div>
      </div>
    </section>
    <section class="section compact white">
      <div class="wrap">
        <p class="answer">{page.answer}</p>
        <div class="card-grid" style="margin-top:22px">
          {page.highlights.map((item) => (
            <article class="card"><h3>{item.title}</h3><p>{item.text}</p></article>
          ))}
        </div>
        <slot />
      </div>
    </section>
    {page.specs && (
      <section class="section compact">
        <div class="wrap">
          <div class="eyebrow">{ui.chrome.specs}</div>
          <h2>{ui.chrome.specsLead}</h2>
          <div class="specs">
            {page.specs.map((spec) => (
              <div><strong>{spec.label}</strong><span>{spec.value}</span></div>
            ))}
          </div>
        </div>
      </section>
    )}
    <section class="section white">
      <div class="wrap prose">
        {page.body.map((block) => (
          <>
            <h2>{block.heading}</h2>
            {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </>
        ))}
      </div>
    </section>
    {page.slug === "certificates" && (
      <section class="section compact">
        <div class="wrap cert-cards">
          <article class="cert"><img src="/assets/cert-9001.jpg" alt={ui.chrome.iso9001} /><p><b>ISO 9001:2015</b><br />{ui.chrome.quality}</p></article>
          <article class="cert"><img src="/assets/cert-14001.jpg" alt={ui.chrome.iso14001} /><p><b>ISO 14001:2015</b><br />{ui.chrome.environment}</p></article>
          <article class="cert"><img src="/assets/cert-45001.jpg" alt={ui.chrome.iso45001} /><p><b>ISO 45001:2018</b><br />{ui.chrome.safety}</p></article>
        </div>
      </section>
    )}
    {(page.slug === "factory" || page.slug === "manufacturing") && (
      <section class="section compact">
        <div class="wrap factory-gallery">
          <img src="/assets/production.jpg" alt={ui.chrome.productionAlt} />
          <img src="/assets/showroom.jpg" alt={ui.chrome.showroomAlt} />
          <img src="/assets/meeting.jpg" alt={ui.chrome.meetingAlt} />
        </div>
      </section>
    )}
    <section class="section compact">
      <div class="wrap">
        <div class="eyebrow">{ui.chrome.questions}</div>
        <h2>{ui.chrome.faq}</h2>
        <div class="faq">
          {page.faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="section white">
      <div class="wrap">
        <div class="related">
          {page.related.map((item) => (
            <a href={item.href}><strong>{item.label}</strong><span>{item.text}</span></a>
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <div class="cta">
          <div>
            <div class="eyebrow" style="color:#938c84">{ui.chrome.start}</div>
            <h2>{ui.chrome.tell}</h2>
            <p>{ui.chrome.sendBrief}</p>
          </div>
          <QuoteForm locale={locale} />
        </div>
      </div>
    </section>
  </main>
</Base>
